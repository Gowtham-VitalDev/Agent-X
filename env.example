# Agentify — Environment Variables Reference
# Copy to .env.local for local development
# Never commit .env.local — it's in .gitignore

# ─── Clerk Auth ──────────────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect URLs (update for production)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── Convex ───────────────────────────────────────────────────────────────────
# Get from: npx convex dev (printed on first run)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Server-side only — for Convex admin operations
CONVEX_DEPLOY_KEY=prod:...

# ─── Arcjet ───────────────────────────────────────────────────────────────────
# Get from: https://app.arcjet.com → Sites → API Keys
ARCJET_KEY=ajkey_...

# ─── AI Providers ─────────────────────────────────────────────────────────────
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google Gemini — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── App Config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Security Notes ───────────────────────────────────────────────────────────
# NEXT_PUBLIC_* vars are bundled into the client — keep them non-sensitive
# All AI provider keys are server-only — never prefix with NEXT_PUBLIC_
# Convex DEPLOY_KEY is server-only — never prefix with NEXT_PUBLIC_
# Arcjet key is server-only — rate limit logic runs server-side only
